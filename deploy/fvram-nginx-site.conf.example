# Nginx del host (puerto 80/443)
# Publica FVRAM en: http://10.69.40.7/fvram/

server {
    listen 80;
    server_name 10.69.40.7;

    # Tu sistema principal puede seguir en /
    location / {
        # Ajusta este upstream a tu sistema principal actual
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Redirige /fvram a /fvram/
    location = /fvram {
        return 301 /fvram/;
    }

    # Ruta separada para FVRAM
    location /fvram/ {
        # El slash final en proxy_pass elimina el prefijo /fvram/
        proxy_pass http://127.0.0.1:8082/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
